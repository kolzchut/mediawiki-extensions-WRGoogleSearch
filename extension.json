{
	"name": "WRGoogleSearch",
	"version": "1.4.0",
	"author": [
		"Dror S. [FFS] ([https://www.kolzchut.org.il Kol-Zchut])",
		"Ryan Finnie"
	],
	"url": "https://www.mediawiki.org/wiki/Extension:GoogleSiteSearch",
	"descriptionmsg": "wrgooglesearch-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "specialpage",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"SpecialPages": {
		"WRGoogleSearch": {
			"class": "MediaWiki\\Extension\\WRGoogleSearch\\Special\\SpecialWRGoogleSearch"
		}
	},
	"MessagesDirs": {
		"WRGoogleSearch": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"WRGoogleSearchAlias": "WRGoogleSearch.alias.php"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\WRGoogleSearch\\": "src/"
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\WRGoogleSearch\\Hooks",
			"services": [ "MainConfig", "UserGroupManager" ]
		}
	},
	"Hooks": {
		"BeforePageDisplay": "main",
		"ResourceLoaderGetConfigVars": "main",
		"SkinAfterBottomScripts": "main"
	},
	"ResourceModules": {
		"ext.wrGoogleSearch.general": {
			"scripts": "ext.wrGoogleSearch.general.js",
			"dependencies": "mediawiki.util"
		},
		"ext.wrGoogleSearch.special": {
			"scripts": "ext.wrGoogleSearch.special.js",
			"styles": [
				"ext.wrGoogleSearch.special.less"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "modules",
		"remoteExtPath": "WikiRights/WRGoogleSearch/modules"
	},
	"config": {
		"WRGoogleSearchCSEID": {
			"value": ""
		},
		"WRGoogleSearchOnly": {
			"value": false
		},
		"WRGoogleSearchExemptGroups": {
			"value": []
		},
		"WRGoogleSearchEnableSitelinksSearch": {
			"value": true
		}
	},
	"manifest_version": 2
}
